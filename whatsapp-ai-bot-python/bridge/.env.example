# --- Server ---
PORT=8000

# --- Bridge (the Node/Baileys connector) ---
BRIDGE_URL=http://localhost:4000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_ai_bot

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Business context for the AI replier (edit this to match your business) ---
AI_SYSTEM_PROMPT="You are a friendly sales assistant for our company. Answer customer questions about our product, be concise and helpful, and if the customer wants to talk further, offer to book a meeting on the calendar."

# --- Google Calendar OAuth2 (see README for how to get these) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary
